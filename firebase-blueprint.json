{
  "entities": {
    "Teacher": {
      "title": "Teacher",
      "description": "Teacher profile and settings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "subject": { "type": "string", "maxLength": 100 },
        "schoolName": { "type": "string", "maxLength": 150 },
        "schoolLevel": { "type": "string", "maxLength": 100 },
        "branch": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 150 },
        "themeColor": { "type": "string", "enum": ["blue", "indigo", "teal", "emerald"] },
        "soundEnabled": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "subject", "schoolName", "email"]
    },
    "ClassItem": {
      "title": "ClassItem",
      "description": "Classroom entity",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 50 },
        "grade": { "type": "number" },
        "room": { "type": "string", "maxLength": 50 },
        "homeroomTeacher": { "type": "string", "maxLength": 100 },
        "academicYear": { "type": "string", "maxLength": 30 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "teacherId", "name", "grade", "homeroomTeacher", "academicYear"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record in a class",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 100 },
        "gender": { "type": "string", "enum": ["Nam", "Nữ"] },
        "classId": { "type": "string", "maxLength": 128 },
        "className": { "type": "string", "maxLength": 50 },
        "birthDate": { "type": "string", "maxLength": 30 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "teacherId", "code", "name", "gender", "classId", "className"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Homework or exercise assigned to classes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "subject": { "type": "string", "maxLength": 100 },
        "content": { "type": "string", "maxLength": 2000 },
        "assignedDate": { "type": "string", "maxLength": 30 },
        "dueDate": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["Đang giao", "Đã hoàn thành", "Đã đóng"] },
        "maxScore": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "teacherId", "title", "subject", "assignedDate", "dueDate", "status", "maxScore"]
    },
    "GradeRecord": {
      "title": "GradeRecord",
      "description": "Individual grade entry for student",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 128 },
        "assignmentId": { "type": "string", "maxLength": 128 },
        "examType": { "type": "string", "enum": ["TX", "BT", "GK", "CK"] },
        "title": { "type": "string", "maxLength": 150 },
        "score": { "type": "number" },
        "date": { "type": "string", "maxLength": 30 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "teacherId", "studentId", "classId", "examType", "title", "score", "date"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily attendance status for a student",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["present", "absent_excused", "absent_unexcused"] },
        "note": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "teacherId", "studentId", "classId", "date", "status"]
    },
    "StudentAssignmentStatus": {
      "title": "StudentAssignmentStatus",
      "description": "Submission and completion tracking for an assignment",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "assignmentId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "isCompleted": { "type": "boolean" },
        "completedAt": { "type": "string", "maxLength": 50 },
        "note": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "teacherId", "assignmentId", "studentId", "isCompleted"]
    }
  },
  "firestore": {
    "/teachers/{teacherId}": {
      "schema": "Teacher",
      "description": "Teacher profile document"
    },
    "/teachers/{teacherId}/classes/{classId}": {
      "schema": "ClassItem",
      "description": "Classes belonging to the teacher"
    },
    "/teachers/{teacherId}/students/{studentId}": {
      "schema": "Student",
      "description": "Students belonging to the teacher"
    },
    "/teachers/{teacherId}/assignments/{assignmentId}": {
      "schema": "Assignment",
      "description": "Assignments created by the teacher"
    },
    "/teachers/{teacherId}/grades/{gradeId}": {
      "schema": "GradeRecord",
      "description": "Grade records entered by the teacher"
    },
    "/teachers/{teacherId}/attendance/{attendanceId}": {
      "schema": "AttendanceRecord",
      "description": "Attendance records tracked by the teacher"
    },
    "/teachers/{teacherId}/studentAssignments/{statusId}": {
      "schema": "StudentAssignmentStatus",
      "description": "Assignment completion status tracked by the teacher"
    }
  }
}
